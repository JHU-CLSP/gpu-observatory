{
  "openapi": "3.1.0",
  "info": {
    "title": "Skipjack monitor",
    "version": "0.1.0"
  },
  "paths": {
    "/stats/skipjack/monitor": {
      "get": {
        "tags": [
          "cluster"
        ],
        "summary": "Get Cluster",
        "operationId": "get_cluster_stats_skipjack_monitor_get",
        "parameters": [
          {
            "name": "user",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "User"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterOverview"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/stats/skipjack/monitor/queue-speed": {
      "get": {
        "tags": [
          "cluster"
        ],
        "summary": "Get Queue Speed",
        "operationId": "get_queue_speed_stats_skipjack_monitor_queue_speed_get",
        "parameters": [
          {
            "name": "window",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "24h",
                "7d",
                "30d"
              ],
              "type": "string",
              "default": "7d",
              "title": "Window"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "all",
                "ours"
              ],
              "type": "string",
              "default": "all",
              "title": "Scope"
            }
          },
          {
            "name": "limited",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "include",
                "exclude"
              ],
              "type": "string",
              "default": "exclude",
              "title": "Limited"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueSpeedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/stats/skipjack/monitor/series": {
      "get": {
        "tags": [
          "cluster"
        ],
        "summary": "Get Series",
        "operationId": "get_series_stats_skipjack_monitor_series_get",
        "parameters": [
          {
            "name": "metric",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "groups",
                "pools"
              ],
              "type": "string",
              "default": "groups",
              "title": "Metric"
            }
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "24h",
                "7d",
                "30d"
              ],
              "type": "string",
              "default": "7d",
              "title": "Window"
            }
          }
