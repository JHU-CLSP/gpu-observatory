              ],
              "title": "Partition"
            }
          },
          {
            "name": "cpus_per_gpu",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 32,
              "minimum": 1,
              "default": 8,
              "title": "Cpus Per Gpu"
            }
          },
          {
            "name": "memory_gib_per_gpu",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 256,
              "minimum": 1,
              "default": 64,
              "title": "Memory Gib Per Gpu"
