# Export these values before starting uvicorn; this file is not loaded automatically.
OBSERVATORY_MONITOR_ENABLED=true
OBSERVATORY_MONITOR_TRANSPORT=auto
OBSERVATORY_MONITOR_SSH_HOST=skipjack
OBSERVATORY_MONITOR_SLURM_BIN_DIR=/opt/mprov/cloack/slurm/current/bin
OBSERVATORY_MONITOR_GROUPS=bvandur1:Ben,dkhasha1:Daniel
# Empty discovers GPU partitions, including hidden condo lanes.
OBSERVATORY_MONITOR_PARTITIONS=
OBSERVATORY_MONITOR_POLL_SECONDS=300
OBSERVATORY_MONITOR_BACKFILL_DAYS=14
OBSERVATORY_MONITOR_COMMAND_TIMEOUT=60
# account:partition start estimates refreshed every 15 minutes; empty disables.
OBSERVATORY_MONITOR_PROBE_AUTO=dkhasha1_safety:h200,bvandur1_blabscify:a100,dkhasha1_h200:h200_condo,dkhasha1_rtx6000:rtx6000_condo
# Default: data/skipjack-monitor.sqlite3 relative to the repository, not the shell.
# OBSERVATORY_MONITOR_DB=/absolute/path/to/skipjack-monitor.sqlite3
# Frontend build/development setting; retain /port5000/ for the existing proxy.
# VITE_BASE_PATH=/
